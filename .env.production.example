# Studio Audax — variáveis de PRODUÇÃO (exemplo)
# Estas variáveis vivem apenas no servidor e nunca no frontend.
# Valores reais são cadastrados direto no painel do provedor (nunca aqui).
# NUNCA use prefixo VITE_ em segredos e NUNCA commite valores reais aqui.
#
# As variáveis abaixo são lidas pelas Edge Functions (Deno.env.get) e ficam no
# SUPABASE:   npx supabase secrets set NOME=valor
# Lista:      npx supabase secrets list

# ---------------------------------------------------------------------------
# Credencial server-to-server (OBRIGATÓRIA para enviar mensagens)
# ---------------------------------------------------------------------------
# ÚNICA credencial aceita para chamar as RPCs do Supabase a partir do webhook
# (supabase/functions/whatsapp-webhook/envio.ts). Precisa ter a chave
# "default" no formato sb_secret_* (secret key do projeto, não a anon key).
# Sem ela o envio é recusado de propósito com "segredo SUPABASE_SECRET_KEYS
# ausente ou inválido" — nada é enviado no lugar.
SUPABASE_SECRET_KEYS=

# ---------------------------------------------------------------------------
# IA do assistente de WhatsApp (OBRIGATÓRIA para a camada de IA)
# ---------------------------------------------------------------------------
# As TRÊS juntas (supabase/functions/whatsapp-webhook/ia.ts). Faltando
# qualquer uma, a IA entra em "sem provedor" e a conversa segue só pelas
# opções fixas — sem chamada externa e sem custo.
# Provedor compatível com a API da OpenAI (qualquer endpoint /v1/chat/completions).
IA_URL=
IA_API_KEY=
IA_MODELO=

# Número autorizado a receber respostas da IA/teste, no formato
# 55DDDNUMERO. Fora dele o envio é bloqueado (whatsapp-enviar e webhook).
IA_NUMERO_TESTE=

# Token dedicado do cron que chama o webhook para processar a fila de
# notificações. Precisa existir dos DOIS lados: esta secret E o par gravado
# no vault (cron_webhook_token / cron_webhook_url) — migration 051.
# Sem os dois, a fila de notificações não roda (o cron recebe 401/500).
CRON_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Evolution API — WhatsApp (envio de texto via Edge Function `whatsapp-enviar`)
# Segredos do SERVIDOR: ficam só no Supabase (npx supabase secrets set ou
# painel → Edge Functions → Secrets), nunca no frontend e nunca com VITE_.
#   npx supabase secrets set EVOLUTION_API_URL=... EVOLUTION_API_KEY=... EVOLUTION_INSTANCE=studio-audax
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=studio-audax

# ---------------------------------------------------------------------------
# LEGADO — mantidos por compatibilidade, NÃO são mais lidos pelo código atual
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_*: o webhook recusa explicitamente esse fallback
# (envio.ts) desde a migração para SUPABASE_SECRET_KEYS.
# GEMINI_API_KEY: nenhuma referência no código — a IA usa IA_URL/IA_API_KEY.
SUPABASE_SERVICE_ROLE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
