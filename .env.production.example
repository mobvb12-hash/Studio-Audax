# Studio Audax — variáveis de PRODUÇÃO (exemplo)
# Estas variáveis vivem apenas no servidor e nunca no frontend.
# Valores reais são cadastrados direto no painel do provedor (nunca aqui).
# NUNCA use prefixo VITE_ em segredos e NUNCA commite valores reais aqui.

# Supabase — service_role (bypassa RLS; só no servidor, nunca no navegador)
SUPABASE_SERVICE_ROLE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API — WhatsApp (envio de texto via Edge Function `whatsapp-enviar`)
# Segredos do SERVIDOR: ficam só no Supabase (npx supabase secrets set ou
# painel → Edge Functions → Secrets), nunca no frontend e nunca com VITE_.
#   npx supabase secrets set EVOLUTION_API_URL=... EVOLUTION_API_KEY=... EVOLUTION_INSTANCE=studio-audax
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=studio-audax

# Google Gemini — chamadas de IA via backend (nunca no navegador)
GEMINI_API_KEY=
