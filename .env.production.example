# Studio Audax — variáveis de PRODUÇÃO (exemplo)
# Estas variáveis vivem apenas no servidor (Render → Environment) e nunca
# no frontend. Valores reais são cadastrados direto no painel do Render.
# NUNCA use prefixo VITE_ em segredos e NUNCA commite valores reais aqui.

# Supabase — service_role (bypassa RLS; só no servidor, nunca no navegador)
SUPABASE_SERVICE_ROLE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API — WhatsApp (envio real ainda NÃO implementado)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Google Gemini — chamadas de IA via backend (nunca no navegador)
GEMINI_API_KEY=
